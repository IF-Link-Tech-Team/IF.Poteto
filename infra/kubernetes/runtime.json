{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "poteto-system"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "poteto-gvisor-installer",
        "namespace": "poteto-system"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {
        "name": "poteto-gvisor-installer"
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "nodes"
          ],
          "verbs": [
            "get",
            "patch"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "poteto-gvisor-installer"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "poteto-gvisor-installer"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "poteto-gvisor-installer",
          "namespace": "poteto-system"
        }
      ]
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "poteto-gvisor-installer",
        "namespace": "poteto-system"
      },
      "data": {}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "name": "poteto-gvisor-installer",
        "namespace": "poteto-system"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app": "poteto-gvisor-installer"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "poteto-gvisor-installer"
            }
          },
          "spec": {
            "serviceAccountName": "poteto-gvisor-installer",
            "hostPID": true,
            "containers": [
              {
                "name": "install",
                "image": "alpine:3.22",
                "command": [
                  "sh",
                  "/scripts/install.sh"
                ],
                "env": [
                  {
                    "name": "NODE_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "spec.nodeName"
                      }
                    }
                  }
                ],
                "securityContext": {
                  "privileged": true
                },
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "96Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "test",
                      "-f",
                      "/tmp/ready"
                    ]
                  },
                  "periodSeconds": 5
                },
                "volumeMounts": [
                  {
                    "name": "host",
                    "mountPath": "/host"
                  },
                  {
                    "name": "scripts",
                    "mountPath": "/scripts",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "host",
                "hostPath": {
                  "path": "/",
                  "type": "Directory"
                }
              },
              {
                "name": "scripts",
                "configMap": {
                  "name": "poteto-gvisor-installer"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "node.k8s.io/v1",
      "kind": "RuntimeClass",
      "metadata": {
        "name": "poteto-ci"
      },
      "handler": "poteto-ci",
      "scheduling": {
        "nodeSelector": {
          "poteto.io/ci-runtime": "gvisor"
        }
      },
      "overhead": {
        "podFixed": {
          "cpu": "50m",
          "memory": "64Mi"
        }
      }
    }
  ]
}
