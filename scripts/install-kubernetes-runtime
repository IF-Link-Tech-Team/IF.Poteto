#!/usr/bin/env python3
"""Install a distinct gVisor CI RuntimeClass and its node bootstrapper."""
import argparse
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[1]


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--kubeconfig', required=True)
    args = parser.parse_args()
    objects = json.loads((ROOT / 'infra/kubernetes/runtime.json').read_text())
    config = next(item for item in objects['items'] if item['kind'] == 'ConfigMap')
    config['data'] = {'install.sh': (ROOT / 'infra/kubernetes/install-gvisor.sh').read_text()}
    subprocess.run(['kubectl', '--kubeconfig', args.kubeconfig, '--request-timeout=30s',
                    'apply', '-f', '-'], input=json.dumps(objects).encode(), check=True)


if __name__ == '__main__':
    main()
